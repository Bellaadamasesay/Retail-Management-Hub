# Locale used for number grouping (Sierra Leone English).
NEXT_PUBLIC_LOCALE=en-SL

# Postgres connection string. On Render, copy the database's "External Database URL" for
# local use, or the "Internal Database URL" when the app itself also runs on Render.
DATABASE_URL=postgres://user:password@host:5432/database

# Signs session cookies: a random string of at least 32 characters. Generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out.
SESSION_SECRET=

# Optional. "verify" checks the database's TLS certificate against the system CAs.
# DATABASE_SSL=verify
